# Copy to backend/.env and adjust. Never commit the real .env.

APP_ENV=development
# REQUIRED in production: long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=120

# SQLite for local dev; PostgreSQL for deployment, e.g.
# DATABASE_URL=postgresql+psycopg://lostlink:lostlink@localhost:5432/lostlink
DATABASE_URL=sqlite:///./lostlink.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Private upload storage (served only through authenticated endpoints)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5
# Cloudinary (production photo storage). REQUIRED when APP_ENV=production; leave empty for local development.
# Placeholders only: put the real values in backend/.env or the hosting provider's environment settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Matching
MATCH_THRESHOLD=0.55
# Visual evidence (see docs/VISION.md). onnx = learned model with heuristic fallback; heuristic = old method only.
VISION_ENABLED=true
VISION_PROVIDER=onnx
VISION_MODEL_PATH=models/vision/mobilenetv2-7-pooled.onnx
VISION_DEVICE=auto
# Optional: first admin account is created on startup if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=
